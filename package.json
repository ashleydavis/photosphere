{
  "name": "photosphere-monorepo",
  "version": "1.0.0",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashleydavis/photosphere.git"
  },
  "bugs": {
    "url": "https://github.com/ashleydavis/photosphere/issues"
  },
  "description": "This monorepo contains the backend and frontend for [the Photosphere application](https://rapidfullstackdevelopment.com/example-application).",
  "homepage": "https://github.com/ashleydavis/photosphere#readme",
  "keywords": [],
  "license": "MIT",
  "scripts": {
    "c": "bun run compile",
    "compile": "bun --filter '*' compile",
    "clean": "bun --filter '*' clean",
    "test": "bun --filter '*' test",
    "test:watch": "bun --filter '*' test:watch",
    "test:all": "bun run test && bun run test:cli && bun run test:cli:encrypted && bun run test:cli:lan-share && bun run test:electron",
    "test:everything": "./scripts/test-everything-parallel.sh",
    "tev": "bun run test:everything",
    "t": "bun run test",
    "tw": "bun run test:watch",
    "ta": "bun run test:all",
    "dev": "bun run bundle:renderer && bun run --filter=photosphere dev",
    "dev:fps": "bun run bundle:renderer && bun run --filter=photosphere dev:fps",
    "dev:web": "concurrently --kill-others --names \"server,frontend\" \"bun run --filter=dev-server dev\" \"bun run --filter=photosphere-frontend dev\"",
    "d": "bun run dev",
    "build": "bun run bundle:renderer && bun run --filter=photosphere build",
    "bundle:main": "bun run --filter=photosphere bundle",
    "bundle:renderer": "bun run --filter=desktop-frontend bundle",
    "bundle": "bun run bundle:main && bun run bundle:renderer",
    "smoke": "bun run test:cli && bun run test:electron",
    "test:electron": "cd ./apps/desktop/ && ./smoke-tests.sh",
    "test:electron:seq": "cd ./apps/desktop/ && ./smoke-tests.sh --sequential",
    "te": "bun run test:electron",
    "test:cli": "cd ./apps/cli && ./smoke-tests.sh",
    "tc": "cd ./apps/cli && ./smoke-tests.sh",
    "test:cli:encrypted": "cd ./apps/cli/ && ./smoke-tests-encrypted.sh",
    "tce": "bun run test:cli:encrypted",
    "test:cli:lan-share": "cd ./apps/cli/ && ./smoke-tests-lan-share.sh",
    "tcl": "bun run test:cli:lan-share",
    "test:cli:hash-cache": "cd ./apps/cli/ && ./hash-cache-smoke-test.sh",
    "test:lan-share:cli-desktop": "./cli-desktop-lan-share-smoke-tests.sh",
    "tlcd": "bun run test:lan-share:cli-desktop",
    "stories": "./scripts/story-player.sh --platform electron",
    "stories:and": "./scripts/story-player.sh --platform android",
    "stories:ios": "./scripts/story-player.sh --platform ios",
    "test:and": "cd ./apps/smoke-tests && PLATFORM=android ./run.sh",
    "tan": "bun run test:and",
    "test:and:lock": "bun run --filter=smoke-tests test:and:lock",
    "test:and:lock-status": "bun run --filter=smoke-tests test:and:lock-status",
    "test:and:unlock": "bun run --filter=smoke-tests test:and:unlock",
    "test:ios": "cd ./apps/smoke-tests && PLATFORM=ios ./run.sh",
    "test:and:unit": "bun run --filter=android-frontend test:unit",
    "test:ios:unit": "bun run --filter=ios-frontend test:unit",
    "build:and": "bun --filter=android-frontend sync && cd ./apps/android-frontend/android && ./gradlew :app:assembleDebug",
    "build:ios": "bun --filter=ios-frontend sync && cd ./apps/ios-frontend/ios/App && xcodebuild -workspace App.xcworkspace -scheme App -destination 'generic/platform=iOS Simulator' build",
    "vendor:imagemagick:ios": "bash ./apps/ios-frontend/ios/build-imagemagick.sh",
    "open:and": "bun run --filter=android-frontend open",
    "open:ios": "bun run --filter=ios-frontend open",
    "run:and": "bun run --filter=android-frontend run",
    "and": "bun run run:and",
    "run:and:50": "bun run --filter=android-frontend run 50",
    "and50": "bun run run:and:50",
    "run:and:1": "bun run --filter=android-frontend run 1",
    "and1": "bun run run:and:1",
    "run:and:0": "bun run --filter=android-frontend run 0",
    "and0": "bun run run:and:0",
    "run:ios": "bun run --filter=ios-frontend run",
    "ios": "bun run run:ios",
    "emu:and:up": "bun run --filter=android-frontend emu:up",
    "emu:and:pool": "bun run --filter=android-frontend emu:pool",
    "emu:and:pool:down": "bun run --filter=android-frontend emu:pool:down",
    "emu:and:down": "bun run --filter=android-frontend emu:down",
    "emu:and:restart": "bun run --filter=android-frontend emu:restart",
    "emu:and:status": "bun run --filter=android-frontend emu:status",
    "screenshots": "bun run bundle && ./apps/desktop/screenshots/capture-ux.sh",
    "perf": "bun --filter '*' perf"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "aux/*"
  ]
}

{
  "name": "photosphere-monorepo",
  "version": "1.0.0",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashleydavis/photosphere.git"
  },
  "bugs": {
    "url": "https://github.com/ashleydavis/photosphere/issues"
  },
  "description": "This monorepo contains the backend and frontend for [the Photosphere application](https://rapidfullstackdevelopment.com/example-application).",
  "homepage": "https://github.com/ashleydavis/photosphere#readme",
  "keywords": [],
  "license": "MIT",
  "scripts": {
    "dev": "zig build photosphere-dev",
    "dev:ui": "bun run --cwd apps/photosphere-frontend dev:ui",
    "c": "bun run compile",
    "setup": "bun --filter '*' setup",
    "compile": "bun --filter '*' compile && what-changed baseline capture compile",
    "clean": "bun --filter '*' clean",
    "test": "bun --filter '*' test && what-changed baseline capture test",
    "test:watch": "bun --filter '*' test:watch",
    "test:everything": "bash ./scripts/test-everything-parallel.sh",
    "test:everything:plan": "bash ./scripts/test-everything-parallel.sh --plan",
    "test:everything:force": "bash ./scripts/test-everything-parallel.sh --force",
    "tev": "bun run test:everything",
    "t": "bun run test",
    "tw": "bun run test:watch",
    "test:cli:zig": "cd ./apps/cli && bash ./smoke-tests-zig.sh --capture-baseline test:cli:zig",
    "test:zig": "zig build test --summary all --test-timeout 20m && what-changed baseline capture test:zig",
    "bundle:ziggy:ui": "bun run --filter=ziggy bundle:ui",
    "bundle:ziggy:core": "bun run --filter=ziggy bundle:core",
    "sync:ziggy:linux": "bun run --filter=ziggy sync:linux",
    "sync:ziggy:windows": "bun run --filter=ziggy sync:windows",
    "sync:ziggy:macos": "bun run --filter=ziggy sync:macos",
    "sync:ziggy:ios": "bun run --filter=ziggy sync:ios",
    "sync:ziggy:android": "bun run --filter=ziggy sync:android",
    "build:ziggy:linux": "bun run --filter=ziggy build:linux",
    "build:ziggy:windows": "bun run --filter=ziggy build:windows",
    "build:ziggy:macos": "bun run --filter=ziggy build:macos",
    "build:ziggy:ios": "bun run --filter=ziggy build:ios",
    "build:ziggy:android": "bun run --filter=ziggy build:android",
    "linux": "bun run --filter=ziggy linux",
    "windows": "bun run --filter=ziggy windows",
    "macos": "bun run --filter=ziggy macos",
    "ios": "bun run --filter=ziggy ios",
    "android": "bun run --filter=ziggy android",
    "android:50": "bun run --filter=ziggy android 50",
    "android:1": "bun run --filter=ziggy android 1",
    "android:0": "bun run --filter=ziggy android 0",
    "open:ziggy:linux": "bun run --filter=ziggy open:linux",
    "open:ziggy:windows": "bun run --filter=ziggy open:windows",
    "open:ziggy:macos": "bun run --filter=ziggy open:macos",
    "open:ziggy:ios": "bun run --filter=ziggy open:ios",
    "open:ziggy:android": "bun run --filter=ziggy open:android",
    "package:ziggy:linux": "bun run --filter=ziggy package:linux",
    "package:ziggy:windows": "bun run --filter=ziggy package:windows",
    "package:ziggy:macos": "bun run --filter=ziggy package:macos",
    "package:ziggy:ios": "bun run --filter=ziggy package:ios",
    "package:ziggy:android": "bun run --filter=ziggy package:android",
    "distribute:ziggy:android": "bun run --filter=ziggy distribute:android",
    "clean:ziggy:linux": "bun run --filter=ziggy clean:linux",
    "clean:ziggy:windows": "bun run --filter=ziggy clean:windows",
    "clean:ziggy:macos": "bun run --filter=ziggy clean:macos",
    "clean:ziggy:ios": "bun run --filter=ziggy clean:ios",
    "clean:ziggy:android": "bun run --filter=ziggy clean:android",
    "setup:ziggy:android": "bun run --filter=ziggy setup:android",
    "setup:ziggy:ios": "bun run --filter=ziggy setup:ios",
    "test:ziggy": "bash ./apps/photosphere-smoke-tests/run-desktop.sh",
    "test:ziggy:and": "bash ./apps/photosphere-smoke-tests/run.sh android",
    "test:ziggy:ios": "bash ./apps/photosphere-smoke-tests/run.sh ios",
    "find-flakey-tests": "bash ./scripts/find-flakey-tests.sh",
    "test:parallel": "bash ./scripts/check-parallel-tests.sh",
    "stories:ziggy": "bash ./scripts/story-player.sh --platform ziggy",
    "stories:ziggy:and": "bash ./scripts/story-player.sh --platform ziggy-android",
    "stories:ziggy:ios": "bash ./scripts/story-player.sh --platform ziggy-ios",
    "s3-emulator": "bash ./scripts/s3-emulator.sh",
    "emu:and:up": "bun run --filter=android-frontend emu:up",
    "emu:and:pool:up": "bun run --filter=android-frontend emu:pool:up",
    "emu:and:pool:down": "bun run --filter=android-frontend emu:pool:down",
    "emu:and:pool:restart": "bun run --filter=android-frontend emu:pool:restart",
    "emu:and:down": "bun run --filter=android-frontend emu:down",
    "emu:and:restart": "bun run --filter=android-frontend emu:restart",
    "emu:and:status": "bun run --filter=android-frontend emu:status",
    "emu:and:pool:status": "bash ./scripts/android-pool-status.sh",
    "emu:and:pool:monitor": "bash ./apps/android-frontend/scripts/emulator-pool-monitor.sh",
    "perf": "bun --filter '*' perf"
  },
  "devDependencies": {
    "ziggy-remote-control-server": "git+https://github.com/ashleydavis/ziggy.git#v0.0.20"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "aux/*"
  ]
}

.{
    .name = .photosphere,
    .version = "1.0.0",
    .fingerprint = 0x65908dac07b847ab,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Ziggy, from the local checkout beside this repository. apps/photosphere-frontend/package.json and
        // apps/photosphere/shells/android/settings.gradle take the same checkout. The Xcode projects under apps/photosphere/shells
        // still take the version tag.
        .ziggy = .{
            .path = "../ziggy",
        },
    },
    .paths = .{ "build.zig", "build.zig.zon" },
}

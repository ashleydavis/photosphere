.{
    .name = .photosphere,
    .version = "1.0.0",
    .fingerprint = 0x65908dac07b847ab,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Ziggy, from the checkout of its repository beside this one. Every other place that takes Ziggy
        // (apps/photosphere-frontend/package.json, the Xcode projects under apps/photosphere/native and
        // apps/photosphere/native/android/settings.gradle) takes the same checkout.
        .ziggy = .{
            .path = "../ziggy",
        },
    },
    .paths = .{ "build.zig", "build.zig.zon" },
}

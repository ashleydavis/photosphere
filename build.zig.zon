.{
    .name = .photosphere,
    .version = "1.0.0",
    .fingerprint = 0x65908dac07b847ab,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Ziggy, at a version tag of its repository. Every other place that takes Ziggy (apps/photosphere-frontend/package.json,
        // the Xcode projects under apps/photosphere/shells and apps/photosphere/shells/android/app/build.gradle) names the same version.
        .ziggy = .{
            .url = "git+https://github.com/ashleydavis/ziggy.git?ref=v0.0.2#c46564e90b1c0e74cd733ded7c0cfcfcb515958a",
            .hash = "ziggy-0.0.0-Yh04rjzdEwDE6oZfjLxVOGHTlCgXdgaCpx67UriT7FDg",
        },
        // zlib-ng, the zlib Bun's node:zlib is built on (see serialization-zig/zlib-ng/zlib-ng.zig).
        .@"zlib-ng" = .{
            .url = "https://github.com/zlib-ng/zlib-ng/archive/refs/tags/2.3.3.tar.gz",
            .hash = "N-V-__8AAPaJcABkB6U-96R7h2xuXX5TlDMvwPbE4PucPI59",
        },
    },
    .paths = .{ "build.zig", "build.zig.zon" },
}

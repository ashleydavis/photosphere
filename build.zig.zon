.{
    .name = .photosphere,
    .version = "1.0.0",
    .fingerprint = 0x65908dac07b847ab,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Ziggy, from the sibling checkout: this build takes Ziggy from `../ziggy`, which every CI workflow checks out beside Photosphere.
        // The frontend package takes the same checkout (apps/photosphere-frontend/package.json); the remote control server, the Xcode
        // projects and native/android/app/build.gradle stay at v0.0.23 until Photosphere moves every part to one Ziggy release.
        .ziggy = .{
            .path = "../../../../ziggy/.claude/worktrees/new-window",
        },
    },
    .paths = .{ "build.zig", "build.zig.zon" },
}

[Unit]
Description=Photosphere Android emulator pool

# WHAT THIS FILE IS
#
# A systemd slice unit. A "slice" is a named group of processes that systemd and the kernel treat as
# one thing for the purpose of resource limits, so a limit written here applies to everything in the
# group added together rather than to any single process. `.slice` is a standard systemd unit type,
# the same family as `.service` and `.timer`; the psphere-pool part is ours.
#
# HOW IT IS USED
#
# systemd only reads this once it is installed in the systemd user unit directory
# ($XDG_CONFIG_HOME/systemd/user, which is under .config in your home directory by default). It does
# not read it from this repository. ensure_pool_slice in emulator.sh installs it there, if it is not
# already there, before starting the first emulator.
#
# start_emulator_bg in the same script then starts each emulator as a transient systemd service with
# --slice=psphere-pool.slice, which is what puts the emulators in this group. Nothing else does. An
# emulator started any other way (Android Studio, a bare `emulator -avd`, run-android.sh) is outside
# this group and is not limited by anything here.
#
# WHY IT EXISTS
#
# The emulators are the largest thing a test run puts on the machine, by a wide margin, and until
# this existed nothing bounded them. A run was able to exhaust both the machine's memory and all of
# its swap. The kernel's task dump at the kill recorded five emulators holding 29.6GB between them,
# the single biggest consumer on the machine. systemd-oomd answered by killing the terminal's cgroup,
# which took every shell in that terminal window with it, including the ones doing the work.
#
# WHY THESE NUMBERS
#
# MemoryHigh is a soft limit: crossing it does not kill anything, it makes the kernel reclaim memory
# from the group, so the emulators page and slow down instead of the whole machine thrashing.
# MemoryMax is the hard ceiling behind it, and crossing that does kill something in the group.
#
# 40G is ABOVE what the pool uses, which is a deliberate reversal of what these numbers used to say.
#
# They used to be 20G and 26G, set below real usage so the ordinary case gave memory back. Measuring
# five emulators against that showed what it cost: each peaked at 4.3GB to 4.5GB, about 22GB between
# them, against a 20G soft limit, so the group sat permanently on the limit and each emulator paged
# roughly 650MB out to swap for the whole of a run. That is reclaim being applied to emulators that
# were behaving, all the time, rather than to a runaway.
#
# 40G leaves the ordinary case alone and keeps MemoryMax as the backstop against the runaway that
# caused this file to exist. The measurement matters more than the number: if the pool's peak ever
# approaches 40G, that is a change worth understanding rather than a limit worth raising again.
#
# The cost is host headroom. This machine has 62GB, so a 46G hard ceiling leaves about 16GB for
# everything else, including the build and the test suites that run alongside the emulators. That is
# closer to the conditions of the original incident than 26G was. If the machine starts thrashing
# with the pool inside its limits, this is the first number to look at.
#
# HOW TO CHECK IT IS IN EFFECT
#
#   systemctl --user show psphere-pool.slice -p MemoryHigh -p MemoryMax
#       What systemd thinks the limits are. Reports 0 or infinity if the unit was never installed.
#
#   systemd-cgtop -m
#       What the group is using right now, live, next to everything else on the machine.
#
[Slice]
MemoryHigh=40G
MemoryMax=46G

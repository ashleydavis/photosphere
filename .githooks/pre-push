#!/usr/bin/env bash
# Refuses a push whose full test set for this platform does not pass.
#
# This is the real gate. `bun run test:all` does not cover either mobile suite, which is the mechanical
# reason a commit that broke 8 of 37 Android smoke tests was pushed without anyone noticing: the
# command named "all" never touched the code that broke.
#
# Everything runs at once via scripts/test-everything-parallel.sh, which also picks the mobile suites
# for the host platform. Sequentially the set takes about eleven minutes; in parallel it is about three
# and a half, and that difference is what keeps the hook switched on rather than bypassed.
#
# The mobile suites are not optional when the push touches mobile code. Unit tests cannot see
# embedded-worker task ordering or the on-device config file, which is exactly what broke, so for a
# push touching mobile paths this hook fails rather than skipping them when no device is attached.
# For a push that touches no mobile code, an absent device drops them with a printed notice.
#
# Nothing here fixes or stages anything: it reports and refuses, leaving the working copy alone.
#
# Bypass with `git push --no-verify` (git handles that natively; there is no flag here).
#
# See docs/git-hooks.md.
#
# Named without a .sh extension against the repository's usual convention because git only recognises
# hooks by these exact filenames.
set -uo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "$HOOK_DIR/.." && pwd)"

cd "$REPO_DIR"

# The all-zero object id git uses for "this ref does not exist", on either side of a push.
ZERO_SHA="0000000000000000000000000000000000000000"

# Stands in for a push whose changed paths cannot be worked out (a brand new remote branch has no
# previous remote state to diff against). Treated as touching mobile code, so an unknown range gates
# harder rather than softer.
UNDETERMINED="<undetermined>"

# Paths whose changes the unit tests cannot cover, so a push touching any of them must run the mobile
# suites. apps/smoke-tests is here because it is the mobile harness itself.
MOBILE_PATHS=(
    "packages/mobile-frontend/"
    "packages/mobile-worker/"
    "apps/android-frontend/"
    "apps/ios-frontend/"
    "apps/smoke-tests/"
)

case "$(uname -s)" in
    Darwin)
        HOST_PLATFORM="macos"
        MOBILE_SCRIPTS=(test:ios test:ios:unit)
        ;;
    *)
        HOST_PLATFORM="linux"
        MOBILE_SCRIPTS=(test:and test:and:unit)
        ;;
esac

HOST_SCRIPTS=(test test:cli test:electron)

# Runs the given scripts through `bun run test:everything`, going through mise when it is available so
# the pinned toolchain versions are used rather than whatever happens to be first on PATH.
run_everything() {
    if command -v mise >/dev/null 2>&1; then
        mise exec -- bun run test:everything "$@"
    else
        bun run test:everything "$@"
    fi
}

# Prints every path the refs on stdin would change, one per line, or the undetermined marker for a ref
# whose range cannot be resolved.
pushed_paths() {
    local local_ref local_sha remote_ref remote_sha
    while read -r local_ref local_sha remote_ref remote_sha; do
        if [ "$local_sha" = "$ZERO_SHA" ]; then
            # Deleting a remote branch pushes no content, so there is nothing to test.
            continue
        fi
        if [ "$remote_sha" = "$ZERO_SHA" ]; then
            echo "$UNDETERMINED"
            continue
        fi
        git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null || echo "$UNDETERMINED"
    done
}

# True when the given newline-separated paths mean the mobile suites are mandatory.
mobile_suites_required() {
    local paths="$1"
    if [ -z "$paths" ]; then
        return 1
    fi
    if printf '%s\n' "$paths" | grep -qF "$UNDETERMINED"; then
        return 0
    fi
    local prefix
    for prefix in "${MOBILE_PATHS[@]}"; do
        if printf '%s\n' "$paths" | grep -q "^$prefix"; then
            return 0
        fi
    done
    return 1
}

# True when a device the mobile suites can run on is attached.
mobile_device_attached() {
    if [ "$HOST_PLATFORM" = "macos" ]; then
        xcrun simctl list devices booted 2>/dev/null | grep -q "Booted"
    else
        adb devices 2>/dev/null | grep -qE "	device$"
    fi
}

CHANGED_PATHS="$(pushed_paths)"

if [ -z "$CHANGED_PATHS" ]; then
    echo "pre-push: nothing to test (no content being pushed)"
    exit 0
fi

echo "pre-push: host platform $HOST_PLATFORM"

SCRIPTS=("${HOST_SCRIPTS[@]}")

if mobile_suites_required "$CHANGED_PATHS"; then
    if ! mobile_device_attached; then
        echo "" >&2
        echo "pre-push FAILED: this push changes mobile code, so these are mandatory," >&2
        printf '    bun run %s\n' "${MOBILE_SCRIPTS[@]}" >&2
        echo "but no device is attached to run them on." >&2
        echo "" >&2
        echo "Mobile paths that make them mandatory:" >&2
        printf '    %s\n' "${MOBILE_PATHS[@]}" >&2
        echo "" >&2
        echo "Start a device, then push again." >&2
        echo "" >&2
        echo "Push anyway with: git push --no-verify" >&2
        exit 1
    fi
    SCRIPTS+=("${MOBILE_SCRIPTS[@]}")
else
    if ! mobile_device_attached; then
        echo "pre-push: skipping ${MOBILE_SCRIPTS[*]}, no device attached and this push changes no mobile code"
    else
        SCRIPTS+=("${MOBILE_SCRIPTS[@]}")
    fi
fi

if ! run_everything "${SCRIPTS[@]}"; then
    echo "" >&2
    echo "pre-push FAILED. Push anyway with: git push --no-verify" >&2
    exit 1
fi

echo "pre-push: passed"

.{
    .name = .lan_share_network_zig,
    .version = "1.0.0",
    .fingerprint = 0x54cfd5c5185288e9,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .@"utils-zig" = .{ .path = "../utils-zig" },
        .@"node-utils-zig" = .{ .path = "../node-utils-zig" },
        // encryption-zig builds aws-lc's libcrypto and libssl: the TLS of the HTTPS server and client that stand in
        // for node:https, and the RSA key and signature of the receiver's self-signed certificate.
        .@"encryption-zig" = .{ .path = "../encryption-zig" },
    },
    .paths = .{ "build.zig", "build.zig.zon", "src" },
}

# Where what-changed keeps its state: baseline.json, the tree it last saw pass, and cache/, which is
# only a speed-up. Must stay ignored: it enumerates untracked files too, so an un-ignored baseline
# would make every run see itself as a change.
.what-changed/
.cache/
tmp/
bundle/
release/
tmp-cli-desktop-lan-share/

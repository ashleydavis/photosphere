<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- For the foreground service that keeps the app running while tasks the app must be kept running for are queued or running.
         POST_NOTIFICATIONS lets its notification show on Android 13 and later. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name="dev.ziggy.shell.ZiggyKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>

{
  "name": "smoke-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Host-driven UI smoke tests and control bridge. Drives an app over a WebSocket from the host (Electron, Android, and iOS).",
  "type": "module",
  "scripts": {
    "t": "bun run test",
    "tw": "bun run test:watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "c": "bun run compile",
    "compile": "tsc --noEmit",
    "clean": "rm -rf build dist coverage tsconfig.tsbuildinfo"
  },
  "keywords": [],
  "author": "ashley@codecapers.com.au",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.4.0",
    "@types/node": "^22.9.1",
    "@types/ws": "^8.5.10",
    "jest": "^29.0.1",
    "ts-jest": "^29.0.5",
    "typescript": "^5.6.3"
  }
}

{
    "include": [
        "lib/**/*",
        "src/**/*"
    ],
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "rootDir": ".",
        "moduleResolution": "bundler",
        "sourceMap": true,
        "outDir": "./build",
        "noEmit": true,
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "types": ["node", "jest"]
    }
}

{
  "name": "android-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "tsc --noEmit",
    "c": "bun run compile",
    "setup": "bash ./scripts/install-android-sdk.sh --install",
    "bundle": "vite build",
    "bundle:worker": "bun --filter=mobile-worker build:bundle && bun --filter=mobile-worker copy:bundle",
    "fetch:media": "bash -c 'source ./scripts/android-env.sh && bash ../../scripts/fetch-mobile-media-tools.sh android'",
    "clean": "rm -rf dist build tsconfig.tsbuildinfo && rm -f android/app/src/main/assets/worker.bundle.js",
    "sync": "bun run fetch:media && bun run bundle:worker && vite build && cap sync android",
    "open": "bun run sync && cap open android",
    "run": "bun run sync && bash ./scripts/run-android.sh",
    "emu:up": "bash ./scripts/emulator.sh up",
    "emu:pool:up": "bash ./scripts/emulator.sh pool-up",
    "emu:pool:down": "bash ./scripts/emulator.sh pool-down",
    "emu:pool:restart": "bash ./scripts/emulator.sh pool-restart",
    "emu:pool:repair": "bash ./scripts/emulator.sh pool-repair",
    "emu:pool:diagnose": "bash ./scripts/emulator.sh pool-diagnose",
    "emu:down": "bash ./scripts/emulator.sh down",
    "emu:restart": "bash ./scripts/emulator.sh restart",
    "emu:status": "bash ./scripts/emulator.sh status",
    "emu:pool:monitor": "bash ./scripts/emulator-pool-monitor.sh",
    "test:unit": "bun run sync && bash ./scripts/android-gradle.sh :app:testDebugUnitTest --rerun-tasks"
  },
  "dependencies": {
    "user-interface": "workspace:*",
    "task-queue": "workspace:*",
    "utils": "workspace:*",
    "mobile-frontend": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.4.1",
    "uuid": "^9.0.1",
    "@capacitor/core": "^5.7.4",
    "@capacitor/android": "^5.7.4",
    "@capacitor/network": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.7.4",
    "@fortawesome/fontawesome-free": "^6.2.1",
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.1.6",
    "typescript": "^5.3.3",
    "tailwindcss": "^3.4.1",
    "postcss": "^8.4.35",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/uuid": "^9.0.8"
  }
}

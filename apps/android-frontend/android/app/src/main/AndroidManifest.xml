<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
          The foreground service that keeps automatic import working while the app is off screen and
          the screen is off. Not exported: nothing outside the app may start it, and nothing outside
          the app has any reason to. Declared as a dataSync service because that is what it does:
          it copies photos from the device library into the database.

          It is started only when the user switches automatic import on. A phone that never switches
          it on never runs it, and never sees its notification.
        -->
        <service
            android:name=".jsengine.AutoImportService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Automatic import reads the device photo library. Android 13 split the old storage permission
      into per-type media ones, so both are declared: the new ones for 13 and later, and the old one
      capped below 13 for the versions that only understand it.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
      The background import runs as a foreground service, which the platform requires to post an
      ongoing notification. Android 13 will not show that notification without POST_NOTIFICATIONS,
      and the service then runs invisibly, which is the opposite of what a foreground service is for.
      It is declared here but asked for only when automatic import is switched on.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      The service holds a wake lock only while a pass is actually running, so the CPU keeps working
      with the screen off. It is released between passes: held for the life of the service it would
      flatten a phone overnight.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
</manifest>

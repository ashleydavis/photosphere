{
  "name": "ios-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "tsc --noEmit",
    "c": "bun run compile",
    "bundle": "vite build",
    "bundle:worker": "bun --filter=mobile-worker build:bundle && bun --filter=mobile-worker copy:bundle",
    "clean": "rm -rf dist build tsconfig.tsbuildinfo",
    "sync": "bun run bundle:worker && vite build && cap sync ios",
    "open": "bun run sync && cap open ios",
    "launch": "bun run bundle:worker && vite build && cap run ios"
  },
  "dependencies": {
    "user-interface": "workspace:*",
    "task-queue": "workspace:*",
    "utils": "workspace:*",
    "mobile-frontend": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.4.1",
    "uuid": "^9.0.1",
    "@capacitor/core": "^5.7.4",
    "@capacitor/ios": "^5.7.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.7.4",
    "@fortawesome/fontawesome-free": "^6.2.1",
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.1.6",
    "typescript": "^5.3.3",
    "tailwindcss": "^3.4.1",
    "postcss": "^8.4.35",
    "autoprefixer": "^10.4.18",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/uuid": "^9.0.8"
  }
}

<?xml version="1.0" encoding="UTF-8"?>
<!--
    The MSI installer for Photosphere on Windows, compiled by WiX Toolset 3 (candle and light). Built by
    package-windows.sh, which defines:
        Version     the app's version, as major.minor.build
        SourceDir   the directory holding photosphere.exe, which is the whole app
    The installer is unsigned and installs for the current user only, into %LOCALAPPDATA%\Programs\Photosphere, so it
    needs no administrator rights. It adds a Start menu shortcut, and Windows Installer adds the entry in Installed apps.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <!-- The UpgradeCode stays the same for every version, so installing a newer one replaces the older one. -->
    <Product Id="*" Name="Photosphere" Language="1033" Version="$(var.Version)" Manufacturer="Photosphere" UpgradeCode="FCDE1E98-4BAF-487C-B2F1-C2E796021F2B">
        <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" InstallPrivileges="limited" Platform="x64" />
        <MajorUpgrade DowngradeErrorMessage="A newer version of Photosphere is already installed." />
        <MediaTemplate EmbedCab="yes" />

        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="LocalAppDataFolder">
                <Directory Id="ProgramsFolder" Name="Programs">
                    <Directory Id="INSTALLFOLDER" Name="Photosphere" />
                </Directory>
            </Directory>
            <Directory Id="ProgramMenuFolder" />
        </Directory>

        <!--
            A per-user component's key path must be a registry value under HKCU rather than a file, which is what Windows
            Installer checks to know whether the component is installed. RemoveFolder takes the folders away on uninstall when
            they are left empty.
        -->
        <DirectoryRef Id="INSTALLFOLDER">
            <Component Id="AppExecutable" Guid="A5E16D69-E308-4B4E-89FF-63BA14D2A1DF" Win64="yes">
                <File Id="PhotosphereExe" Source="$(var.SourceDir)\photosphere.exe" KeyPath="no" />
                <RegistryValue Root="HKCU" Key="Software\au.com.codecapers.photosphere" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
                <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
                <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
            </Component>
        </DirectoryRef>

        <DirectoryRef Id="ProgramMenuFolder">
            <Component Id="StartMenuShortcut" Guid="EDE931D7-3BD7-44D0-BB42-88610A3F442B" Win64="yes">
                <Shortcut Id="PhotosphereShortcut" Name="Photosphere" Target="[INSTALLFOLDER]photosphere.exe" WorkingDirectory="INSTALLFOLDER" />
                <RegistryValue Root="HKCU" Key="Software\au.com.codecapers.photosphere" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
            </Component>
        </DirectoryRef>

        <Feature Id="App" Title="Photosphere" Level="1">
            <ComponentRef Id="AppExecutable" />
            <ComponentRef Id="StartMenuShortcut" />
        </Feature>
    </Product>
</Wix>

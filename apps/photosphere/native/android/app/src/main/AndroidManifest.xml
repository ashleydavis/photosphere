<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The asset server listens on the loopback address, and opening a socket needs this permission. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The background sync asks what kind of connection the phone has, so it can keep to Wi-Fi when the user asked it to. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Automatic import reads the device photo library. Android 13 split the old storage permission into per-type media ones, so
      both are declared: the new ones for 13 and later, and the old one capped below 13 for the versions that only understand it.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
      Android 14 gives the user a third answer besides allow and deny: pick some photos. Declaring this is what makes that partial
      grant persist, and what lets the app tell a partial grant apart from a refusal. An app targeting 34 or later that does not
      declare it is run in compatibility mode, where the media permissions are taken away the moment the app goes to the background.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!--
      Android removes the GPS location from the EXIF of a library photo unless the app holds this permission and opens the photo as
      the original. Without it every geotagged photo would import with no location.
    -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />

    <!--
      The background work holds a wake lock only while a pass is running, so the CPU keeps working with the screen off. It is
      released between passes: held for the life of the service it would flatten a phone overnight.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:label="Photosphere"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true">
        <!-- exported is required for an activity with an intent filter from Android 12, and the launcher needs it. The
             configuration changes are handled in place, because recreating the activity would destroy the core. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
